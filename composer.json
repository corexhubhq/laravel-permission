{
    "name": "corexhubhq/laravel-permission",
    "description": "Role, team and permission management for Laravel",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0",
        "illuminate/database": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Corexhubhq\\LaravelPermission\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Corexhubhq\\LaravelPermission\\PermissionServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
